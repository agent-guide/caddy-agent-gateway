# Caddy Agent Gateway — OTLP usage-event export example
#
# Demonstrates the `metrics.otlp` block: every usage event (LLM/MCP/ACP/
# builtin) is exported as one OpenTelemetry span to an OTLP collector, in
# addition to the SQLite event tables and the Prometheus exposition endpoint.
# Events carry W3C trace/span/parent ids, so the collector reconstructs the
# full interaction span tree — including the internal model/tool calls of
# builtin-agent turns.
#
# Quick local backend (collector + UI in one container):
#
#   docker run --rm -p 16686:16686 -p 4317:4317 -p 4318:4318 \
#     jaegertracing/all-in-one:latest
#
# Then run the gateway and send a few requests:
#
#   ./agw run --config ./examples/Caddyfile.otlp.example
#   open http://localhost:16686   # traces appear under service "agent-gateway"
{
	admin localhost:2019

	agent_gateway {
		config_store sqlite {
			path ./data/configstore.db
		}

		provider openai-main {
			provider_type openai
			api_key {$OPENAI_API_KEY:sk-replace-me}
			default_model gpt-4.1
		}

		route openai-chat {
			protocol openai
			path_prefix /
			require_virtual_key
			target provider openai-main
		}

		metrics {
			retention_days 30
			max_agent_depth 0

			otlp {
				# Collector address as host:port, or a full URL such as
				# http://collector.internal:4318/v1/traces. Export is disabled
				# when no endpoint is configured.
				endpoint 127.0.0.1:4317

				# OTLP transport: "grpc" (default, collector port 4317) or
				# "http" (OTLP/HTTP protobuf, collector port 4318).
				protocol grpc

				# Disable transport TLS for a plaintext local collector. When
				# the endpoint is a full URL, the scheme decides instead.
				insecure

				# Optional headers sent with every export request, e.g. auth
				# tokens for a hosted backend. Repeat for multiple headers.
				# header Authorization "Bearer token"

				# OTel resource service.name for exported spans.
				# Default: agent-gateway
				service_name agent-gateway

				# Per-batch export timeout in seconds. Default: 10
				timeout_seconds 10

				# Optional: additionally export one span per eino chat-model
				# component call, nested under the interaction span. Off by
				# default (multiplies span volume).
				# components
			}
		}
	}
}

http://127.0.0.1:8080 {
	agent_route_dispatcher {
		llm_api openai
		llm_api anthropic
		llm_api cc
	}
}
