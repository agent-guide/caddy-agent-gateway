# Caddy Agent Gateway
# Caddy App module ID: "agent_gateway"
# HTTP handler module IDs:
# - "http.handlers.agent_gateway_admin" (Caddyfile directive: "agent_gateway_admin")
# - "http.handlers.agent_route_dispatcher" (Caddyfile directive: "agent_route_dispatcher")
# Dispatcher LLM API module IDs:
# - "agent_route_dispatcher.llm_apis.openai"
# - "agent_route_dispatcher.llm_apis.anthropic"
# - "agent_route_dispatcher.llm_apis.cc"

{
	admin localhost:2019

	# Global error/module log — controls where h.logger.Info/Debug/Error calls go.
	# This is separate from the per-site HTTP access log below.
	log {
		output stderr
		format console
		level DEBUG
	}

	agent_gateway {
		config_store sqlite {
			path ./data/configstore.db
		}

		metrics {
			retention_days 30
			max_agent_depth 0
			# Optional: export usage events as OpenTelemetry spans to an OTLP
			# collector. Export is disabled when no endpoint is configured.
			# otlp {
			#	endpoint 127.0.0.1:4317
			#	protocol grpc
			#	insecure
			#	header Authorization "Bearer token"
			#	service_name agent-gateway
			#	timeout_seconds 10
			# }
		}
	}
}

http://localhost:8019 {
	# Admin routes
	route /admin/* {
		# Exempt the public health probe and CORS preflight (which carries no
		# credentials) so browser admin UIs and health checks keep working.
		@needauth {
			not path /admin/health
			not method OPTIONS
		}
		basic_auth @needauth {
			default $2a$14$Qxwz94t//fcaF.lyVzsIee0ZZuSNgS841WmLUo/NKGN5LlQzNg5Me # dummy
		}
		agent_gateway_admin
	}
}

http://127.0.0.1:8080 {
	log {
		output stderr
		format console
		level DEBUG
	}

	# LLM API routes
	agent_route_dispatcher {
		llm_api openai
		llm_api anthropic
		llm_api cc
		# Enable MCP and ACP handling. MCP/ACP services and routes are created
		# through the Admin API (acp_services store), not in this Caddyfile;
		# `acp` exposes POST /<acp-route>/turn with SSE for codex/opencode.
		mcp
		acp
		# Enable builtin-agent turn ingress: agents with runtime.type = "builtin"
		# (hosted by the in-process ADK host) are exposed through builtin routes
		# as POST /<builtin-route>/turn with SSE.
		builtin
	}
}
