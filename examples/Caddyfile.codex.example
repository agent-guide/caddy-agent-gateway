# Caddy Agent Gateway
# Caddy App module ID: "agent_gateway"
# HTTP handler module IDs:
# - "http.handlers.agent_gateway_admin" (Caddyfile directive: "agent_gateway_admin")
# - "http.handlers.agent_route_dispatcher" (Caddyfile directive: "agent_route_dispatcher")
# Dispatcher LLM API module IDs:
# - "agent_route_dispatcher.llm_apis.openai"
# - "agent_route_dispatcher.llm_apis.anthropic"
# - "agent_route_dispatcher.llm_apis.cc"

{
	admin localhost:2019

	log {
		output stderr
		format console
		level INFO
	}

	agent_gateway {
		config_store sqlite {
			path ./data/configstore.db
		}

		provider zhipu-for-codex {
			provider_type zhipu
			api_key {$ZHIPU_API_KEY}
			base_url https://open.bigmodel.cn/api/coding/paas/v4
			default_model glm-5.2
			option thinking_type disabled
			# Codex needs no compat option here: zhipu is a real OpenAI-compatible
			# endpoint, so it does not gate on Claude Code tool names and the Codex
			# Responses->chat conversion drops the metadata/user fields. The codex
			# tool-name aliasing (option compact codex) only applies to the
			# claudecode/Anthropic-relay provider.
		}

		provider deepseek-for-codex {
			provider_type deepseek
			api_key {$DEEPSEEK_API_KEY}
			base_url https://api.deepseek.com
			default_model deepseek-v4-pro
		}
		
		route codex-zp-chat {
			protocol openai
			path_prefix /codexzpchat
			require_virtual_key false
			target provider zhipu-for-codex
		}

		route codex-ds-chat {
			protocol openai
			path_prefix /codexdschat
			require_virtual_key false
			target provider deepseek-test
		}

                metrics {
                        retention_days 30
                        max_agent_depth 0
                }
	}
}

http://localhost:8019 {
	# Admin routes
	route /admin/* {
		# Exempt the public health probe and CORS preflight (which carries no
		# credentials) so browser admin UIs and health checks keep working.
		@needauth {
			not path /admin/health
			not method OPTIONS
		}
		basic_auth @needauth {
			default $2a$14$Qxwz94t//fcaF.lyVzsIee0ZZuSNgS841WmLUo/NKGN5LlQzNg5Me # dummy
		}
		agent_gateway_admin
	}
}

http://127.0.0.1:8080 {
	log {
		output stderr
		format console
	}

	# LLM API routes
	agent_route_dispatcher {
		llm_api openai
	}
}
