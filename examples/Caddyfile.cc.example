# Caddy Agent Gateway
# Caddy App module ID: "agent_gateway"
# HTTP handler module IDs:
# - "http.handlers.agent_gateway_admin" (Caddyfile directive: "agent_gateway_admin")
# - "http.handlers.agent_route_dispatcher" (Caddyfile directive: "agent_route_dispatcher")
# Dispatcher LLM API module IDs:
# - "agent_route_dispatcher.llm_apis.openai"
# - "agent_route_dispatcher.llm_apis.anthropic"
# - "agent_route_dispatcher.llm_apis.cc"

{
	admin localhost:2019

	log {
		output stderr
		format console
		level INFO
	}

	agent_gateway {
		config_store sqlite {
			path ./data/configstore.db
		}

		provider zhipu-for-cc {
			provider_type zhipu
			api_key {$ZHIPU_API_KEY}
			base_url https://open.bigmodel.cn/api/coding/paas/v4
			default_model glm-5.2
			option thinking_type disabled
			# Claude Code CLI compatibility: strip the top-level metadata/user
			# fields GLM rejects with a 400.
			option compact cc
		}

		route cc-zp-chat {
			protocol cc
			path_prefix /cczpchat
			require_virtual_key false
			target provider zhipu-for-cc
		}
	}
}

http://localhost:8019 {
	# Admin routes
	route /admin/* {
		# Exempt the public health probe and CORS preflight (which carries no
		# credentials) so browser admin UIs and health checks keep working.
		@needauth {
			not path /admin/health
			not method OPTIONS
		}
		basic_auth @needauth {
			default $2a$14$Qxwz94t//fcaF.lyVzsIee0ZZuSNgS841WmLUo/NKGN5LlQzNg5Me # dummy
		}
		agent_gateway_admin
	}
}

http://127.0.0.1:8080 {
	log {
		output stderr
		format console
	}

	# LLM API routes
	agent_route_dispatcher {
		llm_api anthropic
	}
}
